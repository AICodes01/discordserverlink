# Database configuration
DATABASE_URL="file:./dev.db" # or "postgresql://user:password@localhost:5432/discordserverlink?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="https://discordserverlink.com"
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"

# Discord OAuth2 (https://discord.com/developers/applications)
# Set Redirect URI to: https://discordserverlink.com/api/auth/callback/discord
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"

# Site Public Variables
NEXT_PUBLIC_SITE_URL="https://discordserverlink.com"
NEXT_PUBLIC_SITE_NAME="DiscordServerLink"
NEXT_PUBLIC_DOMAIN="discordserverlink.com"
